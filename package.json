{
  "name": "galiot",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Galiot — a self-hosted S3 file browser. The Bun server signs and connects to S3; the host must be able to reach the bucket. MIT.",
  "license": "MIT",
  "scripts": {
    "dev": "bun scripts/copy-pdfjs-assets.ts && vite",
    "server": "bun run scripts/server.ts",
    "build": "bun scripts/copy-pdfjs-assets.ts && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "bun test",
    "test:integrity": "bun run scripts/integrity-test.ts",
    "test:minio": "bun run scripts/minio-test.ts",
    "test:minio-server": "bun run scripts/server-minio-test.ts",
    "bench": "bun run scripts/bench.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6",
    "@codemirror/commands": "^6",
    "@codemirror/lang-css": "^6",
    "@codemirror/lang-html": "^6",
    "@codemirror/lang-javascript": "^6",
    "@codemirror/lang-json": "^6",
    "@codemirror/lang-markdown": "^6",
    "@codemirror/lang-python": "^6",
    "@codemirror/lang-sql": "^6",
    "@codemirror/lang-yaml": "^6",
    "@codemirror/language": "^6",
    "@codemirror/legacy-modes": "^6",
    "@codemirror/merge": "^6",
    "@codemirror/search": "^6",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-react": "^0.4.8",
    "@tanstack/react-virtual": "^3.14.13",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
